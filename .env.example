# Session signing secret — used by middleware + /api/auth/session Route Handler
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED for server-side auth to work. Keep this value secret and server-side only.
SESSION_SECRET=

# Webhook Configuration
# Used for DataForSEO callback routing. Falls back to VERCEL_DOMAIN if not set.
API_BACKEND_DOMAIN=www.hotelplustr.com

# Other required variables (refer to production environment for values)
# GEMINI_API_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# CRON_SECRET=

# Localized Event Intelligence Keys (Optional Free Tiers)
# PREDICTHQ_API_KEY=
# TICKETMASTER_API_KEY=
# EVENTBRITE_API_KEY=
