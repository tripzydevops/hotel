# ==============================================================================
# Hotel Rate Sentinel — Environment Variables
# ==============================================================================

# Session signing secret — used by middleware + /api/auth/session Route Handler
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED for server-side auth to work. Keep this value secret and server-side only.
SESSION_SECRET=

# Webhook Configuration
# Used for DataForSEO callback routing. Falls back to VERCEL_DOMAIN if not set.
API_BACKEND_DOMAIN=www.hotelplustr.com

# ==============================================================================
# Canonical Data Platform (InsForge / Supabase-compatible PostgreSQL)
# Both variable conventions are supported across frontend and backend.
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://pa5riyqv.eu-central.insforge.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional InsForge aliases (interchangeable with SUPABASE_* keys):
# NEXT_PUBLIC_INSFORGE_URL=https://pa5riyqv.eu-central.insforge.app
# NEXT_PUBLIC_INSFORGE_ANON_KEY=
# INSFORGE_SERVICE_ROLE_KEY=

# ==============================================================================
# External Service API Keys
# ==============================================================================
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Scraper & OTA Data Providers
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=

# Push Notifications (Web Push / VAPID)
VAPID_SUBJECT=mailto:admin@hotelplustr.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Maintenance & Cron Trigger Secret
CRON_SECRET=

# Localized Event Intelligence Keys (Optional Free Tiers)
# PREDICTHQ_API_KEY=
# TICKETMASTER_API_KEY=
# EVENTBRITE_API_KEY=
