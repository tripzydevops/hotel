{
    "include": [
        "."
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "venv"
    ],
    "venvPath": ".",
    "venv": "venv",
    "executionEnvironments": [
        {
            "root": ".",
            "extraPaths": [
                ".",
                "venv/lib/python3.11/site-packages"
            ]
        }
    ],
    "reportMissingTypeStubs": false,
    "pythonVersion": "3.11",
    "typeCheckingMode": "basic"
}
