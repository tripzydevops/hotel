{
    "include": [
        "backend/api",
        "backend/services",
        "backend/models",
        "backend/agents",
        "backend/config"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "venv",
        ".venv",
        ".git",
        "backend/tests",
        "scripts",
        "scratch"
    ],
    "venvPath": ".",
    "venv": ".venv",
    "executionEnvironments": [
        {
            "root": ".",
            "pythonVersion": "3.11",
            "extraPaths": [
                ".",
                "backend",
                "backend/api"
            ]
        }
    ],
    "typeCheckingMode": "basic",
    "reportMissingTypeStubs": false,
    "reportOptionalSubscript": false,
    "reportOptionalMemberAccess": false,
    "reportIndexIssue": false,
    "reportAttributeAccessIssue": "warning"
}
