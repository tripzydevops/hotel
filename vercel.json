{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python"
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/landing/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/v1/(.*)",
      "destination": "https://pa5riyqv.insforge.site/auth/v1/$1"
    },
    {
      "source": "/rest/v1/(.*)",
      "destination": "https://pa5riyqv.insforge.site/rest/v1/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}