{
  "functions": {
    "python_bridge/index.py": {
      "runtime": "@vercel/python",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/python_bridge/index.py"
    },
    {
      "source": "/p-api/:path*",
      "destination": "/python_bridge/index.py"
    }
  ]
}